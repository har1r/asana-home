datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PENGINPUT
  PENELITI
  PENGARSIP
  PENGIRIM
  PEMANTAU
  SUPERVISOR
}

enum JenisPermohonan {
  MUTASI_SEBAGIAN
  MUTASI_HABIS_UPDATE
  MUTASI_HABIS_REGULER
  OBJEK_PAJAK_BARU
  PEMBETULAN
  PENGAKTIFAN
  MUTASI_PENGGABUNGAN
}

enum StatusPermohonan {
  SUBMITTED
  BUNDLED
  ARCHIVED
  MANIFESTED
  DELIVERED
  COMPLETED
  REJECTED
  REVISION
}

enum StatusBundle {
  DRAFT
  LOCKED
  IN_MANIFEST
  VOID
}

enum StatusManifest {
  DRAFT
  LOCKED
  SENT
  VOID
}

enum StatusArsipDigital {
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum StatusKoreksi {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum JenisKoreksi {
  REVISI_DARI_PENELITI
  KEMBALIKAN_DARI_PENGARSIP
  KEMBALIKAN_DARI_PENGIRIM
  KEMBALIKAN_DARI_PUSAT
}

model User {
  id                          String              @id @default(auto()) @map("_id") @db.ObjectId
  name                        String
  email                       String              @unique
  passwordHash                String
  role                        UserRole
  isActive                    Boolean             @default(true) 
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  // Relasi dengan model lainnya
  daftarInput                 Permohonan[]        @relation(name: "PenginputPermohonan")
  daftarPantau                Permohonan[]        @relation(name: "PemantauPermohonan")
  daftarBundle                Bundle[]
  daftarManifest              Manifest[]
  daftarArsipDigital          ArsipDigital[]
  daftarAjuan                 PermintaanKoreksi[] @relation(name: "PengajuKoreksi")
  daftarPutusan               PermintaanKoreksi[] @relation(name: "PemutusKoreksi")
  daftarInAppNotification     InAppNotification[]
}

model Permohonan {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  jenisPermohonan      JenisPermohonan
  nomorPermohonan      String?          @unique
  tanggalNoPelayanan   DateTime?        @default(now())
  tanggalPenyelesaian  DateTime?
  dataLama             DataLama[]
  dataBaru             DataBaru[]
  versi                Int              @default(1)
  status               StatusPermohonan @default(SUBMITTED)
  isFavorite           Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  completedAt          DateTime?

  // Relasi dengan model lainnya
  penginputId          String           @db.ObjectId
  penginput            User             @relation(name: "PenginputPermohonan", fields: [penginputId], references: [id])
  pemantauId           String?          @db.ObjectId
  pemantau             User?            @relation(name: "PemantauPermohonan", fields: [pemantauId], references: [id])
  bundleId             String?          @db.ObjectId
  bundle               Bundle?          @relation(fields: [bundleId], references: [id])
  permintaanKoreksi    PermintaanKoreksi[]
}

type DataLama {
  nopLama              String?
  namaPemilikLama      String?
  alamatPemilikLama    String?
  blokPemilikLama      String?
  rtPemilikLama        String?
  rwPemilikLama        String?
  kecamatanPemilikLama String?
  desaPemilikLama      String?
  alamatObjekLama      String?
  blokObjekLama        String?
  rtObjekLama          String?
  rwObjekLama          String?
  kecamatanObjekLama   String?
  desaObjekLama        String?
  luasTanahLama        Float?
  luasBangunanLama     Float?
  sertifikatLama       String?
  isUtama              Boolean    @default(false)
  catatan              String?
}

type DataBaru {
  nopBaru              String?
  namaPemilikBaru      String?
  noWhatsapp           String?          @map("nomorWhatsapp")
  alamatPemilikBaru    String?
  blokPemilikBaru      String?
  rtPemilikBaru        String?
  rwPemilikBaru        String?
  kecamatanPemilikBaru String?
  desaPemilikBaru      String?
  alamatObjekBaru      String?
  blokObjekBaru        String?
  rtObjekBaru          String?
  rwObjekBaru          String?
  kecamatanObjekBaru   String?
  desaObjekBaru        String?
  luasTanahBaru        Float?
  luasBangunanBaru     Float?
  sertifikatBaru       String?
  isVerified           Boolean    @default(false)
  catatan              String?

  arsipDigital         ArsipDigital[]
}

type ArsipDigital {
  urlBlob       String
  versi         Int                @default(1)
  status        StatusArsipDigital @default(ACTIVE)
  createdAt     DateTime           @default(now())

  // Relasi dengan model lainnya
  pengarsipId   String             @db.ObjectId
  pengarsip     User               @relation(fields: [pengarsipId], references: [id])
  permohonanId  String             @db.ObjectId
  permohonan    Permohonan         @relation(fields: [permohonanId], references: [id])
}

model Bundle {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  nomorBundle     String           @unique
  jenisPermohonan JenisPermohonan?
  versi           Int              @default(1)
  status          StatusBundle     @default(DRAFT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relasi dengan model lainnya
  penelitiId      String           @db.ObjectId
  peneliti        User             @relation(fields: [penelitiId], references: [id])
  manifestId      String?          @db.ObjectId
  manifest        Manifest?        @relation(fields: [manifestId], references: [id])
  permohonan      Permohonan[]
}

model Manifest {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  nomorManifest    String         @unique
  buktiTandaTerima String?
  versi            Int            @default(1)
  status           StatusManifest @default(DRAFT)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  
  // Relasi dengan model lainnya
  pengirimId       String         @db.ObjectId
  pengirim         User           @relation(fields: [pengirimId], references: [id])
  bundle           Bundle[]
}

model PermintaanKoreksi {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  jenisKoreksi      JenisKoreksi
  catatanPengaju    String
  catatanSupervisor String?
  status            StatusKoreksi @default(PENDING_APPROVAL)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  diputuskanAt      DateTime?
  reminderSentAt    DateTime?
  escalationSentAt  DateTime?

  // Relasi dengan model lainnya
  pengajuId         String        @db.ObjectId
  pengaju           User          @relation(name: "PengajuKoreksi", fields: [pengajuId], references: [id])
  supervisorId      String?       @db.ObjectId
  supervisor        User?         @relation(name: "PemutusKoreksi", fields: [supervisorId], references: [id])
  permohonanId      String        @db.ObjectId
  permohonan        Permohonan    @relation(fields: [permohonanId], references: [id])
}

model InAppNotification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  judul     String
  pesan     String
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relasi dengan model lainnya
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  entityType    String
  entityId      String?  @db.ObjectId
  aksi          String
  statusSebelum String?
  statusSesudah String?
  pelakuId      String?  @db.ObjectId
  correlationId String?
  metadata      Json?
  createdAt     DateTime @default(now())
}