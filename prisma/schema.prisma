datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PENGINPUT
  PENELITI
  PENGARSIP
  PENGIRIM
  PEMANTAU
  SUPERVISOR
}

enum JenisPermohonan {
  MUTASI_SEBAGIAN
  MUTASI_HABIS_UPDATE
  MUTASI_HABIS_REGULER
  OBJEK_PAJAK_BARU
  PEMBETULAN
  PENGAKTIFAN
  MUTASI_PENGGABUNGAN
}

enum StatusPermohonan {
  SUBMITTED
  REVISION
  BUNDLED
  ARCHIVED
  MANIFESTED
  DELIVERED
  COMPLETED
  REJECTED
}

enum StatusBundle {
  DRAFT
  LOCKED
  IN_MANIFEST
  VOID
}

enum StatusManifest {
  DRAFT
  LOCKED
  SENT
}

enum StatusArsipDigital {
  ACTIVE
  SUPERSEDED
  INVALIDATED
}

enum StatusKoreksi {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId // ID unik pengguna (MongoDB ObjectId)
  name         String   // Nama lengkap pengguna/petugas
  email        String   @unique // Email unik untuk autentikasi login
  passwordHash String   // Kata sandi terenkripsi (hashed)
  role         UserRole // Peran pengguna (PENGINPUT, PENELITI, PENGARSIP, PENGIRIM, PEMANTAU, SUPERVISOR)
  isActive     Boolean  @default(true) // Status keaktifan akun pengguna
  createdAt    DateTime @default(now()) // Waktu akun pertama kali dibuat
  updatedAt    DateTime @updatedAt // Waktu pembaruan data akun terakhir

  permohonan                  Permohonan[] // Relasi ke permohonan yang diinput oleh user ini
  bundle                      Bundle[] // Relasi ke bundle yang dibuat oleh peneliti ini
  manifest                    Manifest[] // Relasi ke manifest yang dibuat oleh pengirim ini
  arsipDigital                ArsipDigital[] // Relasi ke berkas digital yang diupload oleh pengarsip ini
  permintaanKoreksiPengaju    PermintaanKoreksi[] @relation(name: "PengajuKoreksi") // Relasi ke koreksi yang diajukan oleh user ini
  permintaanKoreksiSupervisor PermintaanKoreksi[] @relation(name: "SupervisorKoreksi") // Relasi ke koreksi yang diputuskan oleh supervisor ini
  inAppNotification           InAppNotification[] // Relasi ke notifikasi aplikasi milik user ini
}

model Permohonan {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId // ID unik permohonan (MongoDB ObjectId)
  nomorPermohonan  String           @unique // Nomor registrasi unik berkas permohonan
  jenisPermohonan  JenisPermohonan  // Jenis layanan permohonan (MUTASI_SEBAGIAN, OPB, PEMBETULAN, dll.)
  status           StatusPermohonan @default(SUBMITTED) // Status tahapan berkas (SUBMITTED, BUNDLED, ARCHIVED, dll.)
  bundleId         String?          @db.ObjectId // ID bundle pembungkusan (null jika belum dibundel)
  isFavorite       Boolean          @default(false) // Penanda berkas difavoritkan oleh penginput
  
  // Data wajib pajak (dengan namaWajibPajak dan alamat sebagai derived fields)
  namaWajibPajak   String   // Nama pemohon / wajib pajak utama
  nop              String   // Nomor Objek Pajak (NOP) utama (derived dari DataLama / DataBaru)
  noWhatsapp       String   @map("nomorWhatsapp") // Nomor WhatsApp wajib pajak untuk notifikasi
  alamat           String   // Alamat domisili wajib pajak / alamat objek pajak
  nomorPelayanan   String?  // Nomor tanda terima pelayanan berkas
  tanggalNoPelayanan DateTime? @default(now()) // Tanggal penerbitan nomor pelayanan
  tanggalPenyelesaian DateTime? // Tanggal target batas penyelesaian permohonan

  // Data Lama
  namaPemilikLama      String? // Snapshot nama pemilik NOP asal (untuk berkas tunggal / export)
  alamatPemilikLama    String? // Snapshot alamat pemilik NOP asal
  blokPemilikLama      String? // Snapshot blok/nomor pemilik NOP asal
  rtPemilikLama        String? // Snapshot RT pemilik NOP asal
  rwPemilikLama        String? // Snapshot RW pemilik NOP asal
  kecamatanPemilikLama String? // Snapshot kecamatan pemilik NOP asal
  desaPemilikLama      String? // Snapshot desa/kelurahan pemilik NOP asal
  alamatObjekLama      String? // Snapshot alamat objek pajak asal
  blokObjekLama        String? // Snapshot blok/nomor objek pajak asal
  rtObjekLama          String? // Snapshot RT objek pajak asal
  rwObjekLama          String? // Snapshot RW objek pajak asal
  kecamatanObjekLama   String? // Snapshot kecamatan objek pajak asal
  desaObjekLama        String? // Snapshot desa/kelurahan objek pajak asal
  luasTanahLama        Float?  // Snapshot luas tanah NOP asal (m²)
  luasBangunanLama     Float?  // Snapshot luas bangunan NOP asal (m²)
  sertifikatLama       String? // Snapshot nomor sertifikat tanah NOP asal

  // Relasi Data Lama & Data Baru (One-to-Many)
  dataLama             DataLama[] // Relasi rinci ke daftar NOP asal/lama (bisa >1 untuk mutasi penggabungan)
  dataBaru             DataBaru[] // Relasi rinci ke daftar NOP pecahan/baru (bisa >1 untuk mutasi sebagian)
  
  // Relasi
  penginputId      String           @db.ObjectId // ID user penginput yang merekam permohonan ini
  
  createdAt        DateTime         @default(now()) // Tanggal berkas pertama kali diinput
  updatedAt        DateTime         @updatedAt // Tanggal terakhir berkas diperbarui
  
  arsipDigital      ArsipDigital[] // Relasi ke daftar file PDF scan digital
  permintaanKoreksi PermintaanKoreksi[] // Relasi ke daftar riwayat pengajuan koreksi/retur
  bundle            Bundle?          @relation(fields: [bundleId], references: [id]) // Relasi ke objek Bundle pengelompokan
  penginput         User             @relation(fields: [penginputId], references: [id]) // Relasi ke objek User penginput
}

model DataLama {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId // ID unik rincian NOP asal
  permohonanId         String     @db.ObjectId // ID permohonan pemilik rincian NOP asal ini
  nopLama              String     // Nomor Objek Pajak (NOP) asal
  namaPemilikLama      String     // Nama pemilik NOP asal
  alamatPemilikLama    String     // Alamat pembuat/pemilik NOP asal
  blokPemilikLama      String?    // Blok alamat pemilik NOP asal
  rtPemilikLama        String?    // RT alamat pemilik NOP asal
  rwPemilikLama        String?    // RW alamat pemilik NOP asal
  kecamatanPemilikLama String?    // Kecamatan alamat pemilik NOP asal
  desaPemilikLama      String?    // Desa/Kelurahan alamat pemilik NOP asal
  alamatObjekLama      String?    // Alamat letak objek pajak asal
  blokObjekLama        String?    // Blok letak objek pajak asal
  rtObjekLama          String?    // RT letak objek pajak asal
  rwObjekLama          String?    // RW letak objek pajak asal
  kecamatanObjekLama   String?    // Kecamatan letak objek pajak asal
  desaObjekLama        String?    // Desa/Kelurahan letak objek pajak asal
  luasTanahLama        Float      // Luas tanah NOP asal (m²)
  luasBangunanLama     Float      // Luas bangunan NOP asal (m²)
  isUtama              Boolean    @default(false) // Flag penanda NOP asal utama/terbesar
  
  permohonan           Permohonan @relation(fields: [permohonanId], references: [id], onDelete: Cascade) // Relasi induk ke Permohonan
}

model DataBaru {
  id                   String     @id @default(auto()) @map("_id") @db.ObjectId // ID unik rincian data baru/pecahan
  permohonanId         String     @db.ObjectId // ID permohonan pemilik data baru ini
  namaPemilikBaru      String     // Nama pemilik/pembeli NOP baru
  alamatPemilikBaru    String     // Alamat domisili pemilik NOP baru
  blokPemilikBaru      String?    // Blok alamat pemilik NOP baru
  rtPemilikBaru        String?    // RT alamat pemilik NOP baru
  rwPemilikBaru        String?    // RW alamat pemilik NOP baru
  kecamatanPemilikBaru String     // Kecamatan domisili pemilik NOP baru
  desaPemilikBaru      String     // Desa/Kelurahan domisili pemilik NOP baru
  alamatObjekBaru      String     // Alamat letak objek pajak baru
  blokObjekBaru        String?    // Blok letak objek pajak baru
  rtObjekBaru          String?    // RT letak objek pajak baru
  rwObjekBaru          String?    // RW letak objek pajak baru
  kecamatanObjekBaru   String     // Kecamatan letak objek pajak baru
  desaObjekBaru        String     // Desa/Kelurahan letak objek pajak baru
  luasTanahBaru        Float      // Luas tanah pecahan/baru (m²)
  luasBangunanBaru     Float      // Luas bangunan pecahan/baru (m²)
  sertifikatBaru       String     // Nomor sertifikat tanah baru
  isVerified           Boolean    @default(false) // Status verifikasi centang data pecahan oleh Pemantau
  catatan              String?    // Catatan tambahan data baru
  
  permohonan           Permohonan @relation(fields: [permohonanId], references: [id], onDelete: Cascade) // Relasi induk ke Permohonan
  arsipDigital         ArsipDigital[] // Relasi ke arsip digital PDF khusus pecahan ini
}

model Bundle {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId // ID unik bundle (MongoDB ObjectId)
  nomorBundle     String       @unique // Nomor urut unik berkas bundle (misal: BND/2026/001)
  status          StatusBundle @default(DRAFT) // Status alur bundle (DRAFT, LOCKED, IN_MANIFEST, VOID)
  manifestId      String?      @db.ObjectId // ID manifest pengiriman (null jika belum dikirim)
  jenisPermohonan JenisPermohonan? // Jenis permohonan seragam dalam bundle ini (terkunci setelah terisi)
  
  penelitiId      String       @db.ObjectId // ID user peneliti yang membuat bundle ini
  createdAt       DateTime     @default(now()) // Waktu bundle pertama kali dibuat
  updatedAt       DateTime     @updatedAt // Waktu pembaruan status bundle terakhir
  
  permohonan      Permohonan[] // Relasi ke daftar permohonan yang ada di dalam bundle ini
  manifest        Manifest?    @relation(fields: [manifestId], references: [id]) // Relasi ke objek Manifest pengiriman
  peneliti        User         @relation(fields: [penelitiId], references: [id]) // Relasi ke objek User peneliti
}

model Manifest {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId // ID unik manifest (MongoDB ObjectId)
  nomorManifest  String         @unique // Nomor unik manifest pengiriman (misal: MNF/2026/001)
  status         StatusManifest @default(DRAFT) // Status pengiriman (DRAFT, LOCKED, SENT)
  buktiTandaTerima String?      // URL file PDF/gambar bukti tanda terima pengiriman dari Vercel Blob
  
  pengirimId     String         @db.ObjectId // ID user pengirim/logistik yang mengelola manifest ini
  createdAt      DateTime       @default(now()) // Waktu manifest dibuat
  updatedAt      DateTime       @updatedAt // Waktu status manifest terakhir diubah
  
  bundle         Bundle[] // Relasi ke daftar bundle yang dikirim dalam manifest ini
  pengirim       User           @relation(fields: [pengirimId], references: [id]) // Relasi ke objek User pengirim
}

model ArsipDigital {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId // ID unik arsip PDF digital
  permohonanId  String             @db.ObjectId // ID permohonan pemilik file PDF ini
  urlBlob       String             // Link URL penyimpanan berkas PDF di Vercel Blob Storage
  status        StatusArsipDigital @default(ACTIVE) // Status arsip (ACTIVE, SUPERSEDED/re-upload, INVALIDATED/batal)
  versi         Int                // Nomor versi dokumen (berkurang/bertambah saat upload ulang)
  
  pengarsipId   String             @db.ObjectId // ID user pengarsip yang mengunggah file
  dataBaruId    String?            @db.ObjectId // ID rincian data baru/pecahan (jika PDF khusus per pecahan)
  createdAt     DateTime           @default(now()) // Tanggal & waktu file diunggah
  
  permohonan    Permohonan         @relation(fields: [permohonanId], references: [id]) // Relasi ke permohonan induk
  dataBaru      DataBaru?          @relation(fields: [dataBaruId], references: [id]) // Relasi ke rincian data baru
  pengarsip     User               @relation(fields: [pengarsipId], references: [id]) // Relasi ke user pengarsip
}

model PermintaanKoreksi {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId // ID unik pengajuan koreksi/retur
  permohonanId     String        @db.ObjectId // ID permohonan yang diajukan koreksi
  jenisKoreksi     String        // Jenis aksi koreksi (misal: "KELUARKAN_DARI_BUNDLE", "KEMBALIKAN_KE_PENELITI")
  status           StatusKoreksi @default(PENDING_APPROVAL) // Status persetujuan (PENDING_APPROVAL, APPROVED, REJECTED)
  
  pengajuId        String        @db.ObjectId // ID user yang mengajukan koreksi
  supervisorId     String?       @db.ObjectId // ID supervisor yang mengambil keputusan
  catatanPengaju   String        // Alasan/catatan dari pengaju koreksi
  catatanSupervisor String?      // Catatan arahan dari supervisor saat menyetujui/menolak
  
  reminderSentAt   DateTime?     // Waktu notifikasi ingatan 72 jam terkirim (untuk cron timeout)
  escalationSentAt DateTime?     // Waktu eskalasi 168 jam terkirim ke supervisor (untuk cron timeout)
  
  createdAt        DateTime      @default(now()) // Waktu pengajuan koreksi dibuat
  updatedAt        DateTime      @updatedAt // Waktu pembaruan data koreksi terakhir
  diputuskanAt     DateTime?     // Waktu kepastian keputusan diberikan oleh supervisor

  permohonan       Permohonan    @relation(fields: [permohonanId], references: [id]) // Relasi ke permohonan induk
  pengaju          User          @relation(name: "PengajuKoreksi", fields: [pengajuId], references: [id]) // Relasi ke user pengaju
  supervisor       User?         @relation(name: "SupervisorKoreksi", fields: [supervisorId], references: [id]) // Relasi ke supervisor
}

model InAppNotification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId // ID unik notifikasi sistem
  userId      String   @db.ObjectId // ID user penerima notifikasi
  judul       String   // Judul notifikasi (misal: "Permohonan Perlu Revisi")
  pesan       String   // Isi pesan penjelasan notifikasi
  isRead      Boolean  @default(false) // Penanda apakah notifikasi sudah dibaca oleh user
  metadata    Json?    // Data tambahan JSON (idPermohonan, idBundle, dll.)
  createdAt   DateTime @default(now()) // Tanggal & waktu notifikasi dikirim
  
  user        User     @relation(fields: [userId], references: [id]) // Relasi ke user penerima
}

model AuditLog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId // ID unik catatan audit log
  entityType      String   // Jenis entitas yang diubah ("PERMOHONAN", "BUNDLE", "MANIFEST", "CRON")
  entityId        String?  @db.ObjectId // ID dari entitas terkait
  aksi            String   // Deskripsi nama aksi/kegiatan yang dilakukan
  statusSebelum   String?  // Status entitas sebelum perubahan
  statusSesudah   String?  // Status entitas setelah perubahan
  pelakuId        String?  @db.ObjectId // ID user pelaku yang melakukan perubahan
  correlationId   String?  // ID pelacak transaksi atomik multi-langkah
  metadata        Json?    // Detail metadata perubahan data dalam format JSON
  createdAt       DateTime @default(now()) // Tanggal & waktu kejadian direkam
}
