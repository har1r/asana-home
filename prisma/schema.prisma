// =========================================================================
// APPLICATION, BUNDLE, AND MANIFEST MANAGEMENT SYSTEM
// Database: MongoDB
// Principles: Flexible (Reuse), Trackable (Immutable History), Strict Control
// =========================================================================

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ========================== ENUMS ==========================

enum UserRole {
  DATA_ENTRY
  RESEARCHER
  ARCHIVIST
  SENDER
  MONITOR
  SUPERVISOR
}

enum ApplicationType {
  PARTIAL_MUTATION
  EXPIRED_UPDATE
  EXPIRED_REGULAR
  NEW_TAX_OBJECT
  CORRECTION
  REACTIVATION
  MERGER_MUTATION
}

enum ApplicationStatus {
  SUBMITTED
  REVISION
  BUNDLED
  ARCHIVED
  MANIFESTED
  DELIVERED
  COMPLETED
}

enum BundleStatus {
  DRAFT
  LOCKED
  IN_MANIFEST
}

enum ManifestStatus {
  DRAFT
  LOCKED
  SENT
}

enum DigitalArchiveStatus {
  ACTIVE
  SUPERSEDED
}

enum AuditAction {
  CREATE
  UPDATE_STATUS
  ADD_TO_BUNDLE
  REMOVE_FROM_BUNDLE
  LOCK_BUNDLE
  UNLOCK_BUNDLE
  ADD_TO_MANIFEST
  REMOVE_FROM_MANIFEST
  LOCK_MANIFEST
  SEND_MANIFEST
  TRIGGER_RETURN
  APPROVE_RETURN
  REJECT_RETURN
  UPLOAD_DOCUMENT
  SUBMIT_DATA
  REVISE_DATA
}

enum ReturnOrigin {
  ARCHIVIST
  SENDER
  HEADQUARTERS
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

// ========================== MODELS ==========================

model User {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs    AuditLog[]
  snapshots    ApplicationSnapshot[]
}

model Application {
  id                   String             @id @default(auto()) @map("_id") @db.ObjectId
  applicationType      ApplicationType
  applicationNumber    String             @unique
  serviceNumberDate    DateTime           @default(now())
  completionDate       DateTime 
  
  previousData         PreviousData[]
  targetData           TargetData[]       
  
  status               ApplicationStatus  @default(SUBMITTED)
  currentBundleId      String?            @db.ObjectId  
  isFavorite           Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  currentBundle        Bundle?                    @relation(fields: [currentBundleId], references: [id])
  bundleHistory        ApplicationBundleHistory[]
  snapshots            ApplicationSnapshot[]
  // ✅ auditLogs dihapus karena AuditLog menggunakan entityType & entityId (Polymorphic)
}

type PreviousData {
  nop                 String
  ownerName           String
  ownerAddress        String?
  ownerBlock          String?
  ownerRt             String?
  ownerRw             String?
  ownerKecamatan      String?
  ownerDesa           String?
  objectAddress       String?
  objectBlock         String?
  objectRt            String?
  objectRw            String?
  objectKecamatan     String?
  objectDesa          String?
  landArea            Float
  buildingArea        Float?
  certificate         String?
  isPrimary           Boolean  @default(false)
  notes               String?
}

type TargetData {
  idTargetData        String     @default(uuid())   
  nopTemporary        String?    
  nopFinal            String?    
  ownerName           String
  whatsappNumber      String?    
  ownerAddress        String?
  ownerBlock          String?
  ownerRt             String?
  ownerRw             String?
  ownerKecamatan      String?
  ownerDesa           String?
  objectAddress       String?
  objectBlock         String?
  objectRt            String?
  objectRw            String?
  objectKecamatan     String?
  objectDesa          String?
  landArea            Float
  buildingArea        Float?
  certificate         String?
  isVerified          Boolean    @default(false)
  isArchived          Boolean    @default(false) 
  notes               String?
  digitalArchives     DigitalArchive[]
}

type DigitalArchive {
  idArchive       String                @default(uuid())
  urlBlob         String
  fileName        String?  
  status          DigitalArchiveStatus  @default(ACTIVE)
  uploadedBy      String?               @db.ObjectId 
  createdAt       DateTime              @default(now())
  revisionNote    String?               
  supersededBy    String?               
  supersededAt    DateTime?             
}

model Bundle {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  bundleNumber      String          @unique
  applicationType   ApplicationType 
  status            BundleStatus    @default(DRAFT)
  currentManifestId String?         @db.ObjectId 
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  bundleDocuments   DocumentContainer[] 
  currentManifest   Manifest?                   @relation(fields: [currentManifestId], references: [id])
  applications      Application[]             
  returnRequests    ReturnRequest[]
  applicationHistory ApplicationBundleHistory[]
  manifestHistory   ManifestBundleHistory[]
  // ✅ auditLogs dihapus karena AuditLog menggunakan entityType & entityId (Polymorphic)
}

model Manifest {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  manifestNumber    String          @unique
  signedReceiptUrl  String?         
  status            ManifestStatus  @default(DRAFT)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  manifestDocuments DocumentContainer[] 
  bundles           Bundle[]       
  returnRequests    ReturnRequest[] 
  bundleHistory     ManifestBundleHistory[]
  // ✅ auditLogs dihapus karena AuditLog menggunakan entityType & entityId (Polymorphic)
}

type DocumentContainer {
  idDocument    String   @default(uuid())
  documentType  String   
  urlBlob       String
  fileName      String?
  uploadedBy    String?  @db.ObjectId
  createdAt     DateTime @default(now())
}

// ========================== TRACKABILITY & RETURN ==========================

model AuditLog {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  action      AuditAction 
  entityType  String      // "APPLICATION", "BUNDLE", or "MANIFEST"
  entityId    String      @db.ObjectId
  oldStatus   String?     
  newStatus   String?     
  metadata    Json?       
  createdAt   DateTime    @default(now())
  actorId     String      @db.ObjectId
  actor       User        @relation(fields: [actorId], references: [id])
}

model ReturnRequest {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  origin        ReturnOrigin 
  triggeredBy   String       @db.ObjectId 
  reason        String
  status        ReturnStatus @default(PENDING)
  approvedBy    String?      @db.ObjectId 
  approvedAt    DateTime?
  rejectionNote String?      
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  bundleId      String?      @db.ObjectId
  bundle        Bundle?      @relation(fields: [bundleId], references: [id])
  manifestId    String?      @db.ObjectId
  manifest      Manifest?    @relation(fields: [manifestId], references: [id])
}

model ApplicationBundleHistory {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String       @db.ObjectId
  bundleId      String       @db.ObjectId
  joinedAt      DateTime     @default(now())
  leftAt        DateTime?    
  reasonLeft    String?      
  application   Application  @relation(fields: [applicationId], references: [id])
  bundle        Bundle       @relation(fields: [bundleId], references: [id])
}

model ManifestBundleHistory {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  bundleId      String       @db.ObjectId
  manifestId    String       @db.ObjectId
  joinedAt      DateTime     @default(now())
  leftAt        DateTime?    
  reasonLeft    String?      
  bundle        Bundle       @relation(fields: [bundleId], references: [id])
  manifest      Manifest     @relation(fields: [manifestId], references: [id])
}

model ApplicationSnapshot {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  applicationId  String         @db.ObjectId
  snapshotData   Json           
  snapshotType   String         
  note           String?        
  actorId        String         @db.ObjectId
  createdAt      DateTime       @default(now())
  actor          User           @relation(fields: [actorId], references: [id])
  application    Application    @relation(fields: [applicationId], references: [id])
}